# ── 必填 ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# ── 選填（有則功能更完整）──────────────────────────────────────────
# FinMind Token：三大法人 / 融資融券 / 月營收
# 免費申請：https://finmindtrade.com
FINMIND_TOKEN=

# Admin Token：保護 POST /cache-clear
ADMIN_TOKEN=change-me-please

# 額外允許的 CORS origin（逗號分隔）
ALLOWED_ORIGINS=

# Log level：DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# ── Render 冷啟動防護 ──────────────────────────────────────────────
# server.js 背景 warmup 只在有用戶活動時才觸發
# 要防止 Render spin-down（15分鐘無流量就睡眠），需要外部 cron：
#   https://cron-job.org  → 每 14 分鐘 GET /health
#   https://uptimerobot.com（免費）
